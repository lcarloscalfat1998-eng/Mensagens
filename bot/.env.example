# Copie este arquivo para .env (só para testar no computador).
# No servidor (Render), cadastre estas variáveis no painel, NUNCA no código.

# Chave da API da Anthropic (console.anthropic.com > API Keys)
ANTHROPIC_API_KEY=

# Meta for Developers > seu app > WhatsApp > Configuração da API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta for Developers > seu app > Configurações do app > Básico > Chave secreta do app
WHATSAPP_APP_SECRET=
# Uma senha qualquer que VOCÊ inventa; vai digitar a mesma na tela de webhook da Meta
WHATSAPP_VERIFY_TOKEN=

# Personalização
ASSESSOR_NOME=Seu Nome
EMPRESA_NOME=
BOT_NOME=Assistente

# Opcional
# GRAPH_API_VERSION=v21.0
# PORT=3000
